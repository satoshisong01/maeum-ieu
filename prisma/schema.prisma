// 마음이음 - PostgreSQL (AWS RDS + pgvector)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// NextAuth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  age           Int?
  gender        String?
  guardianName  String?   // 보호자 이름
  guardianPhone String?   // 보호자 연락처
  guardianRelation String? // 보호자 관계 (아들, 딸, 배우자 등)
  guardianEmail String?   // 보호자 이메일 (응급 알림용)
  guardianWebhookUrl String? // 보호자 Webhook URL (Discord/Slack/IFTTT/n8n 등)
  companionName     String?  @default("민지") // AI 동반자 이름
  companionRelation String?  @default("손녀") // AI 동반자 관계 (손녀/손자/딸/아들/며느리/친구 등)
  userHonorific     String?                   // 사용자 호칭 override (null이면 성별 자동 추론)
  screeningMode     String   @default("user")  // 계정 역할: user=일상 대화형 선별 / pro=전문가 표준검사 시행
  expertCode        String?  @unique           // 전문가 초대 코드 (pro 계정이 환자 연결용으로 발급)
  consentedAt       DateTime?                   // 건강정보 수집·이용 동의 시각 (null=미동의)
  consentVersion    String?                     // 동의한 약관 버전
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  medicationSchedules MedicationSchedule[]
  expertLinks   ExpertPatient[] @relation("ExpertLinks")
  patientLinks  ExpertPatient[] @relation("PatientLinks")
}

/// 전문가(의사·간호사·보호사) ↔ 환자 연결. 환자 본인이 마이페이지에서 전문가 코드를 입력해 연결(=본인 동의).
/// 전문가는 연결된 환자의 채점·요약만 열람(대화 원문 비공개 — 프라이버시 기본값).
/// ⚠️ 신규 테이블 생성은 prisma db push 금지(raw 테이블 drop 사고 이력) — 수동 SQL(scripts/ops-create-expert-tables.ts) + prisma generate.
model ExpertPatient {
  id            String   @id @default(cuid())
  expertUserId  String
  patientUserId String
  status        String   @default("active") // active | revoked
  createdAt     DateTime @default(now())

  expert  User @relation("ExpertLinks", fields: [expertUserId], references: [id], onDelete: Cascade)
  patient User @relation("PatientLinks", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@unique([expertUserId, patientUserId])
  @@index([expertUserId])
  @@index([patientUserId])
}

/// 일과/복약 알림 스케줄. 한 사용자에 여러 약 등록 가능.
/// times: ["09:00", "13:00", "20:00"] (KST 24시간 표기)
/// lastTriggeredAt: 마지막 알림 발송 시각 (같은 슬롯 중복 발송 차단용)
model MedicationSchedule {
  id              String   @id @default(cuid())
  userId          String
  label           String   // "혈압약", "당뇨약", "아침 영양제" 등
  times           Json     // string[] — 하루 중 복용 시각 배열
  enabled         Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?  @default("새 대화")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id                String   @id @default(cuid())
  conversationId    String
  role              String
  content           String
  isAnomaly         Boolean? @default(false)
  analysisNote      String?
  emergencyLevel    Int?     // 0=정상, 1=관찰, 2=주의, 3=즉시. null=미평가/AI 발화
  emergencyEvidence String?  // 매칭된 키워드/구문 (디버깅·보호자 알림용)
  notifiedAt        DateTime? // 보호자 알림 발송 시각 (null=미발송)
  speakerLabel      String?  // "primary" | "visitor" | "unknown" — null=미라벨
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// 참고: cognitive_assessments 테이블은 Prisma 외부 (raw SQL)로 관리
// 참고: message_embeddings 테이블은 Prisma 외부 (raw SQL)로 관리
