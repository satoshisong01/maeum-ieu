{
  "name": "maeum-ieu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "audit:user-scope": "npx tsx scripts/audit-user-scope.ts",
    "audit:prompt-leak": "npx tsx scripts/check-prompt-leak.ts",
    "audit:prompt-leak:ci": "npx tsx scripts/check-prompt-leak.ts --regex-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:safety": "npm run audit:prompt-leak:ci && npx tsc --noEmit && vitest run",
    "ci:safety:all": "npm run audit:user-scope; npm run audit:prompt-leak:ci && npx tsc --noEmit"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google-cloud/vertexai": "^1.10.4",
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "firebase-admin": "^14.0.0",
    "maeum-ieu": "file:",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "nodemailer": "^7.0.13",
    "pg": "^8.13.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.60.0",
    "prisma": "^7.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
